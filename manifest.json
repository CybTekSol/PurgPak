{
  "manifest_version": 2,
  "name": "PurgeCompact",
  "version": "1.3.0",
  "author": "CybTekSol",
  "description": "Purge Junk/Trash and compact mail folders across multiple accounts with disk space summaries.",
  "applications": {
    "gecko": {
      "id": "purgecompact@cybteksol.github.com",
      "strict_min_version": "128.0",
      "strict_max_version": "156.*"
    }
  },
  "permissions": [
    "accountsRead",
    "messagesRead",
    "messagesMove",
    "storage",
    "notifications"
  ],
  "browser_action": {
    "default_title": "Run PurgeCompact",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "browser_style": false
  },
  "background": {
    "page": "background.html"
  },
  "experiment_apis": {
    "PurgeCompactAPI": {
      "schema": "api/PurgeCompact/schema.json",
      "parent": {
        "scopes": ["addon_parent"],
        "paths": [["PurgeCompactAPI"]],
        "script": "api/PurgeCompact/implementation.js"
      }
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png"
  }
}