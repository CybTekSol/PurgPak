{
  "manifest_version": 2,
  "name": "PurgPak",
  "version": "1.4.0",
  "author": "CybTekSol [ https://github.com/CybTekSol ]",
  "description": "Purge Junk/Spam/Trash and compact mail folders across multiple accounts with disk space summaries.",
  "applications": {
    "gecko": {
      "id": "purgpak@cybteksol.github.com",
      "strict_min_version": "128.0"
    }
  },
  "permissions": [
    "accountsRead",
    "messagesRead",
    "messagesMove",
    "storage",
    "notifications"
  ],
  "browser_action": {
    "default_title": "Run PurgPak",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "64": "icons/icon-64.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "browser_style": false
  },
  "background": {
    "page": "background.html"
  },
  "experiment_apis": {
    "PurgPakAPI": {
      "schema": "api/schema.json",
      "parent": {
        "scopes": ["addon_parent"],
        "paths": [["PurgPakAPI"]],
        "script": "api/implementation.js"
      }
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "64": "icons/icon-64.png"
  }
}